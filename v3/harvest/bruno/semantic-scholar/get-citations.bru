meta {
  name: Get citations
  type: http
  seq: 4
}

get {
  url: {{ss_base}}/paper/ARXIV:{{arxiv_id}}/citations?fields=title,externalIds&limit=100
  body: none
  auth: none
}

params:query {
  fields: title,externalIds
  limit: 100
}

docs {
  Papers that cite this paper. limit=100 matches the cap used in
  fetch_semantic_scholar_metadata() / SemanticScholarSource.get_citations.
}
