# GPU Gateway — Desktop environment variables
# Copy to .env and fill in values

# Port the gateway listens on
GPU_GATEWAY_PORT=8765

# Optional API key (required when exposed via Cloudflare Tunnel; blank = Tailscale-only)
GPU_GATEWAY_API_KEY=

# SQLite cache path (default: /tmp/gpu_gateway_cache.db)
# GPU_GATEWAY_CACHE_PATH=/data/gpu_gateway_cache.db

# ─── Ollama ───────────────────────────────────────────────────────────────────
# IMPORTANT: set OLLAMA_KEEP_ALIVE=0 in the Ollama systemd unit (/etc/systemd/system/ollama.service.d/override.conf)
# so gemma4:e4b unloads immediately after each request.
# Without this, Ollama holds 4.0GB in VRAM for 5min, causing OOM on the next embed request.
#
# [Service]
# Environment=OLLAMA_KEEP_ALIVE=0

# ─── Mac-side: RAG tools ──────────────────────────────────────────────────────
# Set in your shell profile (or a project .env) on the Mac, not on the desktop.
# Replace <TAILSCALE_IP> with the desktop's Tailscale IP (100.x.x.x from `tailscale status`).
#
# RAG_GPU_GATEWAY_URL=http://<TAILSCALE_IP>:8765
# RAG_GPU_GATEWAY_KEY=                        # leave blank for Tailscale-only access

# ─── Mac-side: graphify ───────────────────────────────────────────────────────
# Route graphify LLM calls through the GPU gateway (Ollama on desktop).
# graphify's ollama backend uses OLLAMA_BASE_URL as the OpenAI-compat base URL;
# the gateway exposes /v1/chat/completions at port 8765.
#
# Graphify forces serial execution (max_concurrency=1) for the ollama backend,
# so concurrent agents will queue automatically at the VRAMCoordinator lock.
# The non-loopback warning graphify prints is cosmetic; the Tailscale WireGuard
# tunnel is encrypted end-to-end.
#
# Option A — env vars (apply per-session or add to shell profile):
#   export OLLAMA_BASE_URL=http://<TAILSCALE_IP>:8765/v1
#   export OLLAMA_MODEL=gemma4:e4b
#   export OLLAMA_API_KEY=gateway          # any non-empty string; suppresses no-key warning
#   graphify extract . --backend ollama    # or: detect_backend() auto-picks ollama
#
# Option B — named provider via ~/.graphify/providers.json (see below); then:
#   graphify extract . --backend gpu-gateway
#
# ~/.graphify/providers.json content for Option B:
# {
#   "gpu-gateway": {
#     "base_url": "http://<TAILSCALE_IP>:8765/v1",
#     "default_model": "gemma4:e4b",
#     "env_key": "GPU_GATEWAY_API_KEY",
#     "pricing": {"input": 0.0, "output": 0.0},
#     "temperature": 0,
#     "max_tokens": 4096
#   }
# }
# GPU_GATEWAY_API_KEY=gateway              # any non-empty string
