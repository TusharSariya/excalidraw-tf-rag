# OpenAlex free key. Singleton lookups are free; metered search/list work is capped locally
# to the daily free-dollar budget so this tool never intentionally consumes prepaid credit.
# OPENALEX_API_KEY=
# RAG_LIT_OPENALEX_CONCURRENCY=32
# RAG_LIT_OPENALEX_RPS=100
# RAG_LIT_OPENALEX_FREE_BUDGET_USD=1.0

# Semantic Scholar shared anonymous pool: burst, cool down on 429, then resume automatically.
# RAG_LIT_S2_CONCURRENCY=32
# RAG_LIT_S2_RPS=1000
# RAG_LIT_S2_COOLDOWN_SECONDS=300

# Optional: CORE API for archive PDF fallbacks (https://core.ac.uk/services/api)
# CORE_API_KEY=
# RAG_LIT_CORE_CONCURRENCY=2
# RAG_LIT_CORE_RPS=0.4166667  # personal key default: 25/min; unauthenticated default: 10/min

# --- Named embed profiles (recommended; see: uv run rag-literature-rag embed profiles) ---
# Local-first, contextual retrieval: promoted 2026-06-22 quality campaign (held-out nDCG@10=0.942,
# vs 0.630/0.667 dense baseline; see docs/quality-campaign-2026-06-22.md). Build on desktop GPU.
RAG_EMBED_PROFILE=cuda-qwen0.6b-contextual-v1
# RAG_EMBED_PROFILE=cuda-qwen0.6b-longrag-v1  # backup arm: held-out nDCG@10=0.924, full-corpus chunks
# RAG_EMBED_PROFILE=cuda-qwen0.6b-1024  # previous default: plain dense+BM25, no context line
# RAG_LIT_EMBED_PROFILE=cuda-qwen4b-1024    # tool-specific override of RAG_EMBED_PROFILE

# GPU dense embed (Ubuntu 3060 Ti; shared scripts in tools/rag-common/scripts/)
# RAG_GPU_SSH=desktop
# RAG_GPU_REMOTE_ROOT=excalidraw-tf-rag
# RAG_GPU_TOOL=tools/rag-literature-rag
# RAG_GPU_TARGET_PROFILE=cuda-qwen0.6b-1024
# RAG_LOCAL_EMBED_DEVICE=cuda
# RAG_CUDA_BATCH_SIZE=8

# --- PDF extraction backend (default pymupdf; docling = local ML) ---
# use `ingest compare-extract --all --limit N` to A/B before committing; switching the
# ingest backend changes embedded/BM25 text and requires `ingest --force --rebuild`.
# RAG_LIT_EXTRACT_WORKERS=4                    # Docling/PyMuPDF processes; 0 or 1 = serial
# RAG_LIT_DOCLING_OCR=0                       # 0 is faster for born-digital papers
# RAG_LIT_DOCLING_TABLES=1                    # preserve table structure
# RAG_LIT_DOCLING_TIMEOUT_S=600               # per-document conversion timeout
# RAG_LIT_DOCLING_DEVICE=auto                 # auto|cpu|cuda|mps|xpu
# RAG_LIT_DOCLING_THREADS=2                   # threads inside each Docling worker

# --- Legacy embedding backend (implicit "default" profile if RAG_EMBED_PROFILE unset) ---
# RAG_EMBED_BACKEND=auto|local

# --- Local ingest (CUDA GPU box) ---
# RAG_EMBED_BACKEND=local
# RAG_LOCAL_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
# RAG_LOCAL_EMBED_DIMS=1024
# RAG_LOCAL_EMBED_QUANT=4bit
# RAG_LIT_WORKERS=48
# RAG_LIT_BIB_RELEVANCE_WORKERS=24            # OpenAlex DOI relevance lookups
# RAG_LIT_BIB_RELEVANCE_CHECKPOINT_EVERY=200 # decisions saved per batch
# RAG_LIT_BIB_SCAN_WORKERS=8                  # local PDF extraction/cache population
# RAG_LIT_INGEST_DOC_BATCH=25
# RAG_LIT_EXTRACT_QUEUE_DOCS=50        # bounded extracted-document queue; default 2 x doc batch
# RAG_LIT_INGEST_SCAN_LOG_EVERY=100
# RAG_LIT_INGEST_PROGRESS_LOG_EVERY=25       # INFO progress/ETA after this many documents
# RAG_LIT_INGEST_PROGRESS_LOG_INTERVAL_S=30  # or after this many seconds, whichever comes first
# MPS fallback (if RAG_LOCAL_EMBED_QUANT=off, Sentence Transformers on MPS):
# RAG_MPS_ENCODE_CHUNK=12
# RAG_MPS_BATCH_SIZE=4
# RAG_QWEN3_QUERY_INSTRUCT=Given a web search query, retrieve relevant passages that answer the query

# Lighter local: RAG_LOCAL_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B  RAG_LOCAL_EMBED_DIMS=1024  RAG_LOCAL_EMBED_QUANT=4bit
# Legacy fallback: RAG_LOCAL_EMBED_MODEL=all-MiniLM-L6-v2  RAG_LOCAL_EMBED_DIMS=384

# RAG_LIT_DOCSUMMARY_OLLAMA_MODEL=gemma4:e4b
# RAG_LIT_DOCSUMMARY_OLLAMA_HOST=http://127.0.0.1:11434

# --- Offline eval judge: direct-HTTP dual backend (DeepSeek + deepseek-v4-flash) --
# eval/judge.py DEFAULTS to this direct-HTTP dual backend (RAG_LIT_JUDGE_BACKEND
# unset == "auto"): DeepSeek API primary, opencode-go Zen fallback on credit/rate-limit
# errors. Bulk judging never routes through the opencode CLI subprocess. Judge is
# OFFLINE-ONLY (never touches production retrieval), so cloud here is fine.
#   RAG_LIT_JUDGE_BACKEND=auto      # (default) DeepSeek primary, fail over to opencode-go
#   RAG_LIT_JUDGE_BACKEND=opencode  # opencode-go Zen only (free credits)
#   RAG_LIT_JUDGE_BACKEND=deepseek  # DeepSeek API only
#   RAG_LIT_JUDGE_BACKEND=local     # opt OUT of the HTTP path; use rag_common.local_llm
#                                   # (Ollama/opencode CLI/gateway) instead
# OPENCODE_API_KEY=                   # else read from ~/.local/share/opencode/auth.json["opencode-go"]
# DEEPSEEK_API_KEY=                   # required for the default deepseek/auto backend
# RAG_LIT_DEEPSEEK_JUDGE_MODEL=deepseek-chat   # DeepSeek-API model name (Zen's deepseek-v4-flash != API id)
# RAG_LIT_JUDGE_HTTP_MODEL=opencode-go/deepseek-v4-flash   # opencode/auto model id

# RAPTOR tree summaries (mlx-qwen4b-raptor-gemma4-v1; requires: uv sync --extra raptor)
# RAG_LIT_RAPTOR_OLLAMA_MODEL=gemma4:e4b
# RAG_LIT_RAPTOR_MAX_DEPTH=3
# RAG_LIT_RAPTOR_MIN_CLUSTER=2
# RAG_LIT_RAPTOR_MAX_CLUSTERS=10

# Each RAG_EMBED_PROFILE gets its own index under data/indexes/{profile}/ (lancedb + ingest_state.json).
# Build multiple indexes for A/B testing: ingest with one profile, then another; query with --embed-profile.
# List built indexes: uv run rag-literature-rag embed indexes

# Ingest: resume with `uv run rag-literature-rag ingest -v` (no --force after interrupt).
# Logs: data/ingest.log. Prevent sleep: caffeinate -dims uv run rag-literature-rag ingest -v
# Do not run query during ingest on 24GB Mac (OOM). Query cost after build: ~$0 local, negligible OpenAI.
# Retrieval benchmark safety for a 24 GB Apple Silicon machine.
RAG_RERANK_BATCH_SIZE=8
RAG_LIT_MAX_CLOUD_RANKING_UNITS=500
